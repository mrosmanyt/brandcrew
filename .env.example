# Brandcrew local environment
# Copy to .env:  cp .env.example .env

# --- App ---
# Public URL used in Stripe redirects (optional for mock billing)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43180

# Random string used to sign session cookies. Change in any shared environment.
SESSION_SECRET=brandcrew-dev-session-secret-change-me

# --- Database (SQLite for local; swap provider to postgresql in prisma/schema.prisma for Postgres) ---
DATABASE_URL="file:./dev.db"

# --- LLM (server-side only — users never paste keys) ---
# Any one key is enough for live generations. No keys → offline demo drafts.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Alias accepted by the Gemini client
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional model overrides (router still picks draft vs final by cost)
OPENAI_DRAFT_MODEL=gpt-4o-mini
OPENAI_FINAL_MODEL=gpt-4.1
ANTHROPIC_DRAFT_MODEL=claude-haiku-4-5
ANTHROPIC_FINAL_MODEL=claude-sonnet-5
GEMINI_DRAFT_MODEL=gemini-2.5-flash
GEMINI_FINAL_MODEL=gemini-2.5-pro

# xAI / Grok is skipped. Do not set those keys for routing.

# --- Browser tools (job runtime) ---
# Headless browse for browser_navigate / browser_snapshot.
# Default true in local `npm run dev` when Chrome is installed.
# Set false on serverless hosts without a browser — tools fall back to
# fetch_url + a depth 1–2 public link crawl (still blocks file:// and private IPs).
PLAYWRIGHT_ENABLED=true
# Optional override if Chrome is not on the default path.
PLAYWRIGHT_CHROME_PATH=

# --- Billing ---
# When true (default for local), Checkout updates the workspace plan without Stripe.
BILLING_MOCK=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STARTER_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
