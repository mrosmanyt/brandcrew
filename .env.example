# CINEM Pro local environment
# Copy to .env:  cp .env.example .env

# --- App ---
# Public URL used in Whop/Stripe redirects (optional for mock billing)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43180
# After Vercel domain console.cinem.tech is Valid:
# NEXT_PUBLIC_CONSOLE_URL=https://console.cinem.tech
# Only if the desk is also on *.cinem.tech (not vercel.app-only):
# COOKIE_DOMAIN=.cinem.tech

# Random string used to sign session cookies. Change in any shared environment.
SESSION_SECRET=brandcrew-dev-session-secret-change-me

# --- Database (Postgres) ---
# Local Docker: docker compose up -d  (see docker-compose.yml)
DATABASE_URL="postgresql://brandcrew:brandcrew@127.0.0.1:5432/brandcrew?schema=public"
# Same as DATABASE_URL for local Docker. On Neon: use the *direct* (unpooled) URL here.
DIRECT_URL="postgresql://brandcrew:brandcrew@127.0.0.1:5432/brandcrew?schema=public"
# Production (Neon): DATABASE_URL = pooled connection string
#   postgresql://...@ep-xxxx.neon.tech/neondb?sslmode=require&pgbouncer=true
# DIRECT_URL = Neon "direct" / unpooled string (required for prisma migrate deploy)
# Prisma no longer uses SQLite. Old file:./dev.db URLs will not generate a client.

# --- LLM (server-side only — users never paste keys) ---
# Founder tip: put Gemini first (GEMINI_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY).
# Free + Starter drafts route to Gemini Flash when that key exists, else OpenAI
# gpt-4o-mini. Two Starter desks (50k tokens each) on Flash/mini stay well under
# ~$20 OpenAI COGS in normal demo/outreach use. OpenAI is for GPT-labelled demos.
# This product uses the Gemini API key path — not Vertex / Google Cloud trial credits.
# Do not add OpenRouter.
# Any one key is enough for live generations. No keys → offline template drafts.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Alias accepted by the Gemini client
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional. Last-resort fallback if other keys are missing.
XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_POSTS_MODEL=grok-3-mini
# Optional later deploy hook — preview never requires Replit login.
# REPLIT_CONNECT_URL=

# Optional model overrides — cheap backends only. The desk picker shows
# marketing names (Opus 4.8, Fable 5.1, GPT Astra, Gemini 3.8 Flash).
# Runtime always uses these cheap ids. Opus is never called.
#   Opus 4.8        → Haiku   (ANTHROPIC_DRAFT_MODEL, default claude-haiku-4-5)
#   Fable 5.1       → Sonnet  (ANTHROPIC_FINAL_MODEL, default claude-sonnet-5)
#   GPT Astra       → GPT Terra cheap OpenAI (OPENAI_DRAFT_MODEL, default gpt-4o-mini)
#   Gemini 3.8 Flash → Gemini Flash (GEMINI_DRAFT_MODEL, default gemini-2.5-flash)
OPENAI_DRAFT_MODEL=gpt-4o-mini
OPENAI_FINAL_MODEL=gpt-4.1
ANTHROPIC_DRAFT_MODEL=claude-haiku-4-5
ANTHROPIC_FINAL_MODEL=claude-sonnet-5
# Optional Ultra/Boost ceiling. Must not be Opus — router refuses opus ids.
# ANTHROPIC_BOOST_MODEL=claude-sonnet-5
GEMINI_DRAFT_MODEL=gemini-2.5-flash
GEMINI_FINAL_MODEL=gemini-2.5-pro

# Internal Admin HQ at /admin (CINEM staff only — not customer-facing).
# Comma-separated. cinemtech@gmail.com is ALWAYS included even if you omit it.
# Production (Vercel → Settings → Environment Variables): set ADMIN_EMAILS to
# every staff email that should open /admin. A signed-in address that is not on
# this list gets HTTP 403. Example for multiple operators:
#   ADMIN_EMAILS=cinemtech@gmail.com,ada@cinem.tech
# To grant a QA account, add that address here only — do not hardcode it in app
# code. Example:
#   ADMIN_EMAILS=cinemtech@gmail.com,qa.cinem.pro.20260907@example.com
ADMIN_EMAILS=cinemtech@gmail.com

# xAI is optional last-resort fallback. Auto posts/research prefer Gemini Flash.
# Google Antigravity agent API is a documented follow-up, not wired in this MVP.

# --- Browser tools (job runtime) ---
# Headless browse for browser_navigate / snapshot / click / type / extract / screenshot.
# Job-scoped Playwright tab on desktop/`npm run dev`. Click/type never fake success on Vercel.
# Default true in local `npm run dev` when Chrome is installed.
# On Vercel / serverless this defaults off even if unset. Set false in Production.
# Set false on serverless hosts without a browser — tools fall back to
# fetch + a depth 1–2 public link crawl (still blocks file:// and private IPs).
PLAYWRIGHT_ENABLED=true
# Optional override if Chrome is not on the default path.
PLAYWRIGHT_CHROME_PATH=

# --- Marketplace plugins ---
# Web Search (Tavily). Paste the same key in Marketplace → Connect, or Connect
# with “Use server TAVILY_API_KEY” when this is set. Empty Connect stays disconnected.
TAVILY_API_KEY=

# Google OAuth — one Web client, two purposes (add BOTH redirect URIs):
# 1) User login (OpenID: openid email profile)
#    {OAUTH_REDIRECT_BASE or APP_URL or NEXT_PUBLIC_APP_URL}/api/auth/google/callback
#    Local:  http://127.0.0.1:43180/api/auth/google/callback
#    Prod:   https://brandcrew.vercel.app/api/auth/google/callback
# 2) Gmail plugin connect (gmail.readonly + gmail.compose) — not a user session
#    {OAUTH_REDIRECT_BASE or APP_URL or NEXT_PUBLIC_APP_URL}/api/oauth/callback
#    Local:  http://127.0.0.1:43180/api/oauth/callback
#    Prod:   https://brandcrew.vercel.app/api/oauth/callback
# Also add Authorized JavaScript origins:
#    http://127.0.0.1:43180
#    https://brandcrew.vercel.app
# Same GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET. Missing env → honest error, never fake Connected.
# OAuth consent in Testing: only listed Test users can Connect Gmail (or sign in with Google).
# Add each address in Google Cloud → APIs & Services → OAuth consent screen → Test users,
# or publish the app to Production. “Access blocked” / Error 403 access_denied is not Connected.
# Optional overrides if you split clients: GOOGLE_LOGIN_CLIENT_ID / GOOGLE_LOGIN_CLIENT_SECRET
# Packaged desktop keeps .env in OS userData (see README → Desktop).
OAUTH_REDIRECT_BASE=
APP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Slack OAuth (Bot token). Same callback path as Google.
# Bot token scopes: channels:read, groups:read, chat:write
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Notion OAuth
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Optional API-key plugins (or paste in Marketplace Connect)
GITHUB_TOKEN=

# --- Composio (Phase 3 marketplace connectors) ---
# Official @composio/core SDK. One project key unlocks Gmail + CRM/SEO toolkits.
# Founder: set COMPOSIO_API_KEY on Vercel (Production + Preview). Never commit the key.
# Missing / placeholder key → Marketplace stays disconnected. CINEM Pro does not fake Connected.
# First proof: Marketplace → Plugins → Run first tool call (Gmail profile if Connected, else Hacker News read).
# Then Connect Gmail (Composio) for a mailbox read. Writes still wait for approval.
COMPOSIO_API_KEY=
# Optional override (default https://backend.composio.dev/api/v3.1)
# COMPOSIO_BASE_URL=
# Optional per-toolkit auth config ids for API-key apps (Apollo, Ahrefs, …)
# COMPOSIO_AUTH_CONFIG_ID=
# COMPOSIO_APOLLO_AUTH_CONFIG_ID=
# COMPOSIO_AHREFS_AUTH_CONFIG_ID=

# --- Billing ---
# Provider: whop (preferred when WHOP_API_KEY is set) → stripe → mock.
# BILLING_MOCK=true forces mock even if Whop/Stripe keys exist (local default).
# Unset BILLING_MOCK or set false for live checkout.
BILLING_MOCK=true
BILLING_PROVIDER=
# Whop (primary live provider). Dashboard: Developer → API keys + Webhooks.
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/webhooks/whop
# Subscribe to payment.succeeded, membership.activated, membership.deactivated.
WHOP_API_KEY=
WHOP_COMPANY_ID=
# Alias accepted for WHOP_COMPANY_ID (biz_…)
WHOP_ACCOUNT_ID=
WHOP_WEBHOOK_SECRET=
# Optional: set true to call https://sandbox-api.whop.com/api/v1
WHOP_SANDBOX=
# Optional mapping to existing Whop plans (plan_…). If unset, checkout creates
# a monthly renewal plan at $20 / $79 / $200.
WHOP_STARTER_PLAN_ID=
WHOP_PRO_PLAN_ID=
WHOP_ULTRA_PLAN_ID=
# Alias accepted for Pro if you still have a Growth plan id
WHOP_GROWTH_PLAN_ID=
# Optional product ids (prod_…) used only when creating inline plans
WHOP_STARTER_PRODUCT_ID=
WHOP_PRO_PRODUCT_ID=
WHOP_ULTRA_PRODUCT_ID=
# Stripe fallback when Whop is not configured
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ULTRA_PRICE_ID=
# Alias accepted for Pro if you still have a Growth price id
STRIPE_GROWTH_PRICE_ID=
# Optional daily cron for scheduled jobs (desk load also enqueues due jobs)
CRON_SECRET=
# WhatsApp plugin is draft-only. Connect stays disconnected without these.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Optional analytics (frontend, only if set) ---
# Google Analytics 4 measurement id. Script loads only after cookie Accept.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXX
# Plausible domain (e.g. brandcrew.vercel.app). Script loads only after Accept.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
