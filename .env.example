# CINEM Pro local environment
# Copy to .env:  cp .env.example .env

# --- App ---
# Public URL used in Whop/Stripe redirects (optional for mock billing)
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43180
# Optional later. Customer API Console nav always uses same-origin /console.
# NEXT_PUBLIC_CONSOLE_URL=https://console.cinem.tech
# Only if the desk is also on *.cinem.tech (not vercel.app-only):
# COOKIE_DOMAIN=.cinem.tech

# Random string used to sign session cookies. Change in any shared environment.
SESSION_SECRET=brandcrew-dev-session-secret-change-me

# Packaged desktop (Electron) talks to the cloud desk by default.
# CINEM_CLOUD_URL=https://brandcrew.vercel.app
# CINEM_DESK_MODE=cloud
# CINEM_DESK_MODE=local keeps the bundled Next server + local Postgres.

# --- Supabase (auth + Postgres) ---
# Existing project: viejyuiiyjmhxfhyuvpa (ap-south-1). Do NOT create a new project.
# Dashboard → Project Settings → API. Never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=https://viejyuiiyjmhxfhyuvpa.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — profile sync, admin auth ops. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Full setup: docs/supabase-setup.md (Email auth, Google provider, SQL migration order).

# --- Database (Postgres) ---
# Local Docker: docker compose up -d  (see docker-compose.yml)
DATABASE_URL="postgresql://brandcrew:brandcrew@127.0.0.1:5432/brandcrew?schema=public"
# Same as DATABASE_URL for local Docker. On Neon/Supabase: use the *direct* (unpooled) URL here.
DIRECT_URL="postgresql://brandcrew:brandcrew@127.0.0.1:5432/brandcrew?schema=public"
# Production (Supabase): DATABASE_URL = pooler (port 6543, ?pgbouncer=true)
#   postgresql://postgres.viejyuiiyjmhxfhyuvpa:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL = direct (port 5432) — required for prisma migrate deploy
#   postgresql://postgres:[PASSWORD]@db.viejyuiiyjmhxfhyuvpa.supabase.co:5432/postgres
# Legacy Neon pooled example:
#   postgresql://...@ep-xxxx.neon.tech/neondb?sslmode=require&pgbouncer=true
# Prisma no longer uses SQLite. Old file:./dev.db URLs will not generate a client.

# --- LLM (server-side only — users never paste keys) ---
# Founder tip: put Gemini first (GEMINI_API_KEY or GOOGLE_GENERATIVE_AI_API_KEY).
# Free + Pro (internal starter id) drafts route to Gemini Flash when that key exists, else OpenAI
# gpt-4o-mini. Two Pro desks (50k tokens each) on Flash/mini stay well under
# ~$20 OpenAI COGS in normal demo/outreach use. OpenAI is for GPT-labelled demos.
# This product uses the Gemini API key path — not Vertex / Google Cloud trial credits.
# Do not add OpenRouter.
# Production (Vercel Production): set GEMINI_API_KEY. If OpenAI/Anthropic keys are
# missing or the paid call errors, desk Q&A and agent chat fall back to Gemini Flash
# instead of a canned English-only refusal. Do not invent keys.
# Any one key is enough for live generations. No keys → offline template drafts.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Alias accepted by the Gemini client
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional. Last-resort fallback if other keys are missing.
XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_POSTS_MODEL=grok-3-mini
# Optional later deploy hook — preview never requires Replit login.
# REPLIT_CONNECT_URL=

# Optional model overrides — cheap backends only. The desk picker shows
# marketing names (Opus 4.8, Fable 5.1, GPT Astra, Gemini 3.8 Flash).
# Runtime always uses these cheap ids. Opus is never called.
#   Opus 4.8        → Haiku   (ANTHROPIC_DRAFT_MODEL, default claude-haiku-4-5)
#   Fable 5.1       → Sonnet  (ANTHROPIC_FINAL_MODEL, default claude-sonnet-5)
#   GPT Astra       → GPT Terra cheap OpenAI (OPENAI_DRAFT_MODEL, default gpt-4o-mini)
#   Gemini 3.8 Flash → Gemini Flash (GEMINI_DRAFT_MODEL, default gemini-2.5-flash)
OPENAI_DRAFT_MODEL=gpt-4o-mini
OPENAI_FINAL_MODEL=gpt-4.1
ANTHROPIC_DRAFT_MODEL=claude-haiku-4-5
ANTHROPIC_FINAL_MODEL=claude-sonnet-5
# Optional Ultra/Boost ceiling. Must not be Opus — router refuses opus ids.
# ANTHROPIC_BOOST_MODEL=claude-sonnet-5
GEMINI_DRAFT_MODEL=gemini-2.5-flash
GEMINI_FINAL_MODEL=gemini-2.5-pro

# Internal Admin HQ at /admin (CINEM staff only — not customer-facing).
# Comma-separated. cinemtech@gmail.com and mrosmanyt@gmail.com are ALWAYS
# included even if you omit them. See docs/admin-ops.md.
# Production (Vercel → Settings → Environment Variables): set ADMIN_EMAILS to
# every staff email that should open /admin. A signed-in address that is not on
# this list gets HTTP 403. Example for multiple operators:
#   ADMIN_EMAILS=cinemtech@gmail.com,mrosmanyt@gmail.com,ada@cinem.tech
# To grant a QA account, add that address here only — do not hardcode it in app
# code. Example:
#   ADMIN_EMAILS=cinemtech@gmail.com,mrosmanyt@gmail.com,qa.cinem.pro.20260907@example.com
ADMIN_EMAILS=cinemtech@gmail.com,mrosmanyt@gmail.com

# xAI is optional last-resort fallback. Auto posts/research prefer Gemini Flash.
# Google Antigravity agent API is a documented follow-up, not wired in this MVP.

# --- Browser tools (job runtime) ---
# Headless browse for browser_navigate / snapshot / click / type / extract / screenshot.
# Job-scoped Playwright tab on desktop/`npm run dev`. Click/type never fake success on Vercel.
# Default true in local `npm run dev` when Chrome is installed.
# On Vercel / serverless this defaults off even if unset. Set false in Production.
# Set false on serverless hosts without a browser — tools fall back to
# fetch + a depth 1–2 public link crawl (still blocks file:// and private IPs).
PLAYWRIGHT_ENABLED=true
# Optional override if Chrome is not on the default path.
PLAYWRIGHT_CHROME_PATH=

# --- Marketplace plugins ---
# Web Search (Tavily). Paste the same key in Marketplace → Connect, or Connect
# with “Use server TAVILY_API_KEY” when this is set. Empty Connect stays disconnected.
TAVILY_API_KEY=

# Google OAuth — one Web client, two purposes (add BOTH redirect URIs):
# 1) User login (OpenID: openid email profile)
#    {OAUTH_REDIRECT_BASE or APP_URL or NEXT_PUBLIC_APP_URL}/api/auth/google/callback
#    Local:  http://127.0.0.1:43180/api/auth/google/callback
#    Prod:   https://brandcrew.vercel.app/api/auth/google/callback
# 2) Gmail plugin connect (gmail.readonly + gmail.compose) — not a user session
#    {OAUTH_REDIRECT_BASE or APP_URL or NEXT_PUBLIC_APP_URL}/api/oauth/callback
#    Local:  http://127.0.0.1:43180/api/oauth/callback
#    Prod:   https://brandcrew.vercel.app/api/oauth/callback
# Also add Authorized JavaScript origins:
#    http://127.0.0.1:43180
#    https://brandcrew.vercel.app
# Same GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET. Missing env → honest error, never fake Connected.
# OAuth consent in Testing: only listed Test users can Connect Gmail (or sign in with Google).
# Add each address in Google Cloud → APIs & Services → OAuth consent screen → Test users,
# or publish the app to Production. “Access blocked” / Error 403 access_denied is not Connected.
# Optional overrides if you split clients: GOOGLE_LOGIN_CLIENT_ID / GOOGLE_LOGIN_CLIENT_SECRET
# Packaged desktop keeps .env in OS userData (see README → Desktop).
OAUTH_REDIRECT_BASE=
APP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Slack OAuth (Bot token). Same callback path as Google.
# Bot token scopes: channels:read, groups:read, chat:write
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Notion OAuth
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Optional API-key plugins (or paste in Marketplace Connect)
GITHUB_TOKEN=

# --- Composio (Phase 3 marketplace connectors) ---
# Official @composio/core SDK. One project key unlocks Gmail + CRM/SEO toolkits.
# Founder: set COMPOSIO_API_KEY on Vercel (Production + Preview). Never commit the key.
# Missing / placeholder key → Marketplace stays disconnected. CINEM Pro does not fake Connected.
# First proof: Marketplace → Plugins → Run first tool call (Gmail profile if Connected, else Hacker News read).
# Then Connect Gmail (Composio) for a mailbox read. Writes still wait for approval.
COMPOSIO_API_KEY=
# Optional override (default https://backend.composio.dev/api/v3.1)
# COMPOSIO_BASE_URL=
# Optional per-toolkit auth config ids for API-key apps (Apollo, Ahrefs, …)
# COMPOSIO_AUTH_CONFIG_ID=
# COMPOSIO_APOLLO_AUTH_CONFIG_ID=
# COMPOSIO_AHREFS_AUTH_CONFIG_ID=

# --- Billing ---
# Provider: whop (preferred when WHOP_API_KEY is set) → stripe → mock.
# BILLING_MOCK=true forces mock even if Whop/Stripe keys exist (local default).
# Unset BILLING_MOCK or set false for live checkout.
BILLING_MOCK=true
BILLING_PROVIDER=
# Whop (primary live provider). Dashboard: Developer → API keys + Webhooks.
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/webhooks/whop
# Subscribe to payment.succeeded, membership.activated, membership.deactivated.
WHOP_API_KEY=
# Company id (biz_…). Required for live checkoutConfigurations.create
# (plan.company_id). Production CINEM Tech: biz_VrtL8S4duREQg4
WHOP_COMPANY_ID=
# Alias accepted for WHOP_COMPANY_ID (sent as account_id for older SDK/API)
WHOP_ACCOUNT_ID=
WHOP_WEBHOOK_SECRET=
# Optional: set true to call https://sandbox-api.whop.com/api/v1
WHOP_SANDBOX=
# Optional mapping to existing Whop plans (plan_…). If unset, checkout creates
# a monthly renewal plan at $20 / $79 / $200.
WHOP_STARTER_PLAN_ID=
WHOP_PRO_PLAN_ID=
WHOP_ULTRA_PLAN_ID=
# Alias accepted for Pro if you still have a Growth plan id
WHOP_GROWTH_PLAN_ID=
# Optional product ids (prod_…) used only when creating inline plans
WHOP_STARTER_PRODUCT_ID=
WHOP_PRO_PRODUCT_ID=
WHOP_ULTRA_PRODUCT_ID=
# Cinem AI Assistant standalone billing (separate from desk plans).
# Public pricing: /cinem-ai-assistant/billing — checkout POST /api/billing/assistant-checkout
WHOP_ASSISTANT_PRODUCT_ID=
WHOP_ASSISTANT_MONTHLY_PLAN_ID=
WHOP_ASSISTANT_3MO_PLAN_ID=
WHOP_ASSISTANT_6MO_PLAN_ID=
WHOP_ASSISTANT_1YR_PLAN_ID=
# Marketing download is the unified Electron installer CINEM-Pro-Setup.exe
# (Actions → CINEM Pro Windows). Optional override:
# CINEM_AI_ASSISTANT_SETUP_URL=
# NEXT_PUBLIC_CINEM_AI_ASSISTANT_SETUP_URL=
# Support (tips): one-time custom $1–$99,999. Create a Whop product named Support
# and paste the product id. Checkout creates a one-time plan per amount (Whop has
# no pay-what-you-want field on checkout configuration). Optional plan id is only
# used to recognize Support webhooks if someone pays that plan from the dashboard.
WHOP_SUPPORT_PRODUCT_ID=
WHOP_SUPPORT_PLAN_ID=
# Stripe fallback when Whop is not configured
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_ULTRA_PRICE_ID=
# Alias accepted for Pro if you still have a Growth price id
STRIPE_GROWTH_PRICE_ID=
# Optional daily cron for scheduled jobs (desk load also enqueues due jobs)
CRON_SECRET=
# WhatsApp plugin is draft-only. Connect stays disconnected without these.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Optional analytics (frontend, only if set) ---
# Google Analytics 4 measurement id. Script loads only after cookie Accept.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXX
# Plausible domain (e.g. brandcrew.vercel.app). Script loads only after Accept.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Windows desktop code signing (release machine / packager CI only) ---
# Do NOT put these on the Vercel web app. They are unused at runtime.
# Empty = unsigned CINEM-Pro-Setup.exe (SmartScreen “Unknown publisher”).
# Founder: Azure Artifact Signing Basic (~$9.99/mo), verify CINEM Tech, then rebuild.
# Guide: docs/windows-code-signing.md
# Never commit filled values. Never commit a .pfx.
#
# Azure Artifact Signing (formerly Trusted Signing) — recommended.
# Service principal secret path (electron-builder 26 win.azureSignOptions):
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Optional instead of AZURE_CLIENT_SECRET (certificate auth):
# AZURE_CLIENT_CERTIFICATE_PATH=
# Regional Endpoint URI — must match the Artifact Signing account region
# (https://learn.microsoft.com/en-us/azure/artifact-signing/how-to-signing-integrations)
# Example West US 2: https://wus2.codesigning.azure.net/
AZURE_TRUSTED_SIGNING_ENDPOINT=
# CodeSigningAccountName (Artifact Signing account name, not the Entra app display name)
AZURE_TRUSTED_SIGNING_ACCOUNT_NAME=
# CertificateProfileName (Public Trust profile)
AZURE_TRUSTED_SIGNING_CERTIFICATE_PROFILE_NAME=
# Certificate Common Name / publisherName (legal entity, e.g. CINEM Tech)
AZURE_TRUSTED_SIGNING_PUBLISHER_NAME=
# Optional timestamp (default http://timestamp.acs.microsoft.com)
# AZURE_TRUSTED_SIGNING_TIMESTAMP_URL=

# --- Image generation — Provider A: Cloudflare Workers AI ---
# Deploy docs/integrations/cloudflare-image-worker/worker.js on your own Worker.
# CINEM Pro calls the worker server-side — never expose the API key to the browser.
# CINEM_IMAGE_GEN_URL=https://your-worker.workers.dev
# CINEM_IMAGE_GEN_API_KEY=

# --- Image generation — Provider B: GeminiGen Nano Banana ---
# Premium GeminiGen plan required for API keys. See docs/integrations/geminigen-image-api/
# GEMINIGEN_API_KEY=
# GEMINIGEN_BASE_URL=https://geminigen.ai
# GEMINIGEN_IMAGE_MODEL=nano-banana
# Optional webhook verification for POST /api/webhooks/geminigen-image
# GEMINIGEN_WEBHOOK_SECRET=

# --- Per-user BYOK (Cinem AI Assistant + desk sync) ---
# User Gemini + Deepgram keys are stored encrypted in Postgres (UserProviderKey).
# Optional BYOK: Cloudflare worker URL + key, or GeminiGen API key (per-user override).
# Never commit real keys. Users paste in Assistant Settings → BYOK or first-run popup.
# Server encrypts with SESSION_SECRET (same as plugin secrets).

# --- Founding members (Cinem AI Assistant) ---
# First 50 signups claim assistantFoundingMember via SiteConfig counter.
# Public countdown: GET /api/founding/spots
# ASSISTANT_FOUNDING_SLOTS is fixed at 50 in src/lib/founding-members.ts (Admin can adjust SiteConfig row).
#
# Viral invite +1 free month: GET /api/user/invite → signup?ref=<code>
# Redemption grants referralBonusMonths (+500 assistant turns/month each) to inviter and invitee.
# Cap: 50 successful invites per inviter (see src/lib/referral-invites.ts).

# --- Offline wake word (Cinem AI Assistant / Electron) ---
# Optional Picovoice Porcupine for always-on offline "Hey Cinem" in the desktop shell.
# Train a custom keyword at https://console.picovoice.ai/ and place hey-cinem.ppn in:
#   %APPDATA%/CINEM Pro/wake-models/hey-cinem.ppn  (Windows userData)
# Or set PORCUPINE_KEYWORD_PATH to the .ppn file. Web Speech fallback works without these.
# PICOVOICE_ACCESS_KEY=

# --- Computer-use MVP (Cinem AI Assistant / Windows Electron) ---
# Ships dark unless enabled. See docs/computer-use-mvp.md
# COMPUTER_USE_ENABLED=1
# PORCUPINE_ACCESS_KEY=
# PORCUPINE_KEYWORD_PATH=

# --- Mobile companion ---
# Pair flow: POST /api/companion/pair (desktop) → open /companion/pair?code= on phone
# Remote commands: POST /api/companion/command with X-Companion-Token header.
# Alternative: traditional OV/EV Authenticode PFX (electron-builder CSC_* ).
# CSC_LINK=
# WIN_CSC_LINK=
# CSC_KEY_PASSWORD=
# WIN_CSC_KEY_PASSWORD=
