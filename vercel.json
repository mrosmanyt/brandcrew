{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "node scripts/prisma-generate.mjs --with-migrate && npx tsx scripts/pack-extension.ts && npx next build",
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "header", "key": "x-forwarded-proto", "value": "https" }],
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/jobs",
      "schedule": "0 12 * * *"
    }
  ]
}
