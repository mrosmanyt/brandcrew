# ── CINEM PRO CLOUD (Brain) — environment ─────────────────────────────
# Copy karo:  cp .env.example .env   phir values bharo.

# Server
PORT=8787
# VPS par apna public HTTPS URL (Google OAuth callback ke liye zaroori)
PUBLIC_URL=http://localhost:8787

# Mock mode: 1 = bina Supabase/Google/LLM keys ke sab kuch fake providers se
# chalta hai (local test ke liye). Production par hamesha 0.
CINEMPRO_MOCK=0

# Supabase (wahi project jo licensing ke liye use ho raha hai, ya naya)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (optional). Khali chhoro to in-process queue chalti hai (single
# server ke liye kaafi). Scale par: REDIS_URL=redis://127.0.0.1:6379
REDIS_URL=

# 32-byte hex key — OAuth tokens DB me isi se encrypt hote hain.
# Banane ke liye:  npm run genkey
TOKEN_ENC_KEY=

# LLM keys (script + SEO)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Model tiers (fast/mid/best) — defaults theek hain, chaaho to badlo
MODEL_FAST=gemini-2.0-flash
MODEL_MID=claude-sonnet-4-5
MODEL_BEST=claude-opus-4-1

# Google OAuth (YouTube connect + upload + analytics)
# Google Cloud Console → Credentials → OAuth client (Web application)
# Authorized redirect URI:  {PUBLIC_URL}/api/connect/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram bot (optional, Phase 4)
TELEGRAM_BOT_TOKEN=
# Webhook set karte waqt yahi secret use hota hai (koi bhi random string)
TELEGRAM_WEBHOOK_SECRET=

# Video generation provider (abhi: mock | none). Jab real API choose kar lo
# (per-video cost test karke), src/pipeline/video.js me provider add karo.
VIDEO_PROVIDER=none

# Files kahan store hon (videos, thumbnails)
STORAGE_DIR=./storage
FFMPEG_PATH=ffmpeg
