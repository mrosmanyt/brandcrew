{
  "name": "brandcrew",
  "version": "0.3.6",
  "private": true,
  "description": "CINEM Pro \u2014 AI employee desk. Mission Control for agents you create. Jobs plan, use tools, and wait for you to approve.",
  "author": "CINEM",
  "scripts": {
    "predev": "node scripts/ensure-dev.mjs",
    "dev": "next dev --hostname 0.0.0.0 --port 43180",
