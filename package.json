{
  "name": "brandcrew",
  "version": "0.1.0",
  "private": true,
  "description": "CINEM Pro — AI employee desk. Mission Control for agents you create. Jobs plan, use tools, and wait for you to approve.",
  "author": "CINEM",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "node scripts/ensure-dev.mjs",
    "dev": "next dev --hostname 0.0.0.0 --port 43180",
    "build": "node scripts/prisma-generate.mjs && next build",
    "start": "next start --hostname 0.0.0.0 --port 43180",
    "lint": "eslint",
    "postinstall": "node scripts/prisma-generate.mjs",
    "db:up": "docker compose up -d",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "node scripts/prisma-generate.mjs",
    "vercel-build": "node scripts/prisma-generate.mjs --with-migrate && next build",
    "test:llm": "tsx scripts/check-llm-router.ts",
    "test:jobs": "tsx scripts/check-job-runtime.ts",
    "test:marketplace": "tsx scripts/check-marketplace.ts",
    "test:oauth": "tsx scripts/check-oauth-plugins.ts",
    "test:browse": "tsx scripts/check-browse.ts",
    "test:api-router": "tsx scripts/check-api-router.ts",
    "test:developer-api": "tsx scripts/check-developer-api.ts",
    "test:limits": "tsx scripts/check-limits.ts",
    "test:desk-chat": "tsx scripts/check-desk-chat.ts",
    "desktop:dev": "node scripts/make-icon.mjs && electron electron/main.cjs",
    "desktop:build": "node scripts/desktop-build.mjs",
    "desktop:build:win": "node scripts/desktop-build.mjs --win",
    "desktop:build:mac": "node scripts/desktop-build.mjs --mac"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@base-ui/react": "^1.8.0",
    "@google/genai": "^2.21.0",
    "@prisma/client": "^6.16.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "jose": "^6.2.12",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "openai": "^7.10.0",
    "playwright-core": "^1.63.0",
    "prisma": "^6.16.3",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "stripe": "^22.6.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "build": {
    "appId": "com.brandcrew.desktop",
    "productName": "CINEM Pro",
    "copyright": "Copyright © CINEM",
    "directories": {
      "output": "dist/desktop",
      "buildResources": "electron/resources"
    },
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json",
      "!**/node_modules/**"
    ],
    "asar": true,
    "npmRebuild": false,
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "standalone"
      },
      {
        "from": "electron/resources",
        "to": "brandcrew",
        "filter": [
          "icon.png",
          "env.example"
        ]
      }
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "electron/resources/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false,
      "identity": null
    },
    "win": {
      "icon": "electron/resources/icon.png",
      "executableName": "CINEM-Pro",
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CINEM Pro",
      "uninstallDisplayName": "CINEM Pro",
      "artifactName": "CINEM-Pro-Setup.${ext}"
    },
    "portable": {
      "artifactName": "CINEM-Pro-Portable.${ext}"
    },
    "linux": {
      "icon": "electron/resources/icon.png",
      "category": "Office",
      "target": [
        "AppImage"
      ]
    }
  }
}
