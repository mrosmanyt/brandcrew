{
  "manifest_version": 3,
  "name": "CINEM Pro — live browser",
  "version": "0.3.0",
  "description": "CINEM Pro AI in your Chrome. Supervised live-browser employee — navigate, snapshot, and click with approval. Writes wait for you.",
  "icons": {
    "16": "icons/cinem-logo.png",
    "48": "icons/cinem-logo.png",
    "128": "icons/cinem-logo.png"
  },
  "action": {
    "default_title": "CINEM Pro",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/cinem-logo.png",
      "48": "icons/cinem-logo.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "nativeMessaging",
    "alarms",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.cinem.tech/*",
    "https://brandcrew.vercel.app/*",
    "https://*/*"
  ]
}
