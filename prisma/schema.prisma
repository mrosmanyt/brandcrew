generator client {
  provider      = "prisma-client-js"
  // native = local/desktop; rhel-openssl-3.0.x = Vercel (Amazon Linux 2023)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon pooled URL cannot run migrations. Local Docker: same as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  /// Null for Google-only accounts. Email/password users always have a hash.
  passwordHash String?
  /// Google account `sub`. Distinct from Marketplace Gmail plugin tokens.
  googleId     String?           @unique
  name         String
  createdAt    DateTime          @default(now())
  memberships  WorkspaceMember[]
  invitesSent  WorkspaceInvite[]
}

model Workspace {
  id                 String            @id @default(cuid())
  name               String
  slug               String            @unique
  plan               String            @default("demo")
  tokenUsed          Int               @default(0)
  tokenBudget        Int               @default(15000)
  brandKit           String            @default("{}")
  modelRouting       String            @default("auto")
  /// Last Whop membership that granted the current paid plan. Used to match deactivates.
  whopMembershipId   String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  members            WorkspaceMember[]
  conversations      Conversation[]
  artifacts          Artifact[]
  tasks              Task[]
  calendarItems      CalendarItem[]
  usageEvents        UsageEvent[]
  jobs               Job[]
  skills             Skill[]
  agents             Agent[]
  pluginConnections  PluginConnection[]
  apiKeys            ApiKey[]
  invites            WorkspaceInvite[]
  schedules          ScheduledJob[]

  @@index([whopMembershipId])
}

model Agent {
  id            String         @id @default(cuid())
  workspaceId   String
  name          String         @default("New Agent")
  role          String         @default("")
  instructions  String         @default("")
  templateId    String?
  /// JSON array of JobTool names. Empty array means all default tools.
  allowedTools  String         @default("[]")
  status        String         @default("active")
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobs          Job[]
  conversations Conversation[]
  artifacts     Artifact[]
  skills        Skill[]
  usageEvents   UsageEvent[]
  schedules     ScheduledJob[]

  @@index([workspaceId, status])
  @@index([workspaceId, templateId])
}

model PluginConnection {
  id          String    @id @default(cuid())
  workspaceId String
  pluginId    String
  status      String    @default("disconnected")
  metadata    String    @default("{}")
  secretEnc   String    @default("")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, pluginId])
  @@index([workspaceId, status])
}

model WorkspaceMember {
  id                   String    @id @default(cuid())
  workspaceId          String
  userId               String
  role                 String    @default("owner")
  onboardingDismissed  Boolean   @default(false)
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model WorkspaceInvite {
  id          String     @id @default(cuid())
  workspaceId String
  email       String
  token       String     @unique
  role        String     @default("member")
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime   @default(now())
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User       @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@index([expiresAt])
}

model ScheduledJob {
  id          String    @id @default(cuid())
  workspaceId String
  agentId     String?
  title       String
  message     String
  playbookKey String?
  cadence     String
  timezone    String    @default("UTC")
  nextRunAt   DateTime
  lastRunAt   DateTime?
  lastJobId   String?
  enabled     Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent       Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([workspaceId, enabled, nextRunAt])
  @@index([enabled, nextRunAt])
}

model Conversation {
  id          String     @id @default(cuid())
  workspaceId String
  agentId     String?
  agentRole   String
  createdAt   DateTime   @default(now())
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent       Agent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)
  messages    Message[]
  artifacts   Artifact[]

  @@unique([workspaceId, agentRole])
  @@index([workspaceId, agentId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Artifact {
  id             String        @id @default(cuid())
  workspaceId    String
  conversationId String?
  jobId          String?
  agentId        String?
  agentRole      String
  type           String
  title          String
  content        String
  status         String        @default("draft")
  model          String        @default("demo")
  provider       String        @default("demo")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  job            Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  agent          Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  tasks          Task[]
}

model Task {
  id          String    @id @default(cuid())
  workspaceId String
  artifactId  String?
  title       String
  description String    @default("")
  status      String    @default("approve")
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  artifact    Artifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)
}

model CalendarItem {
  id          String    @id @default(cuid())
  workspaceId String
  date        String
  title       String
  channel     String
  content     String    @default("")
  artifactId  String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model UsageEvent {
  id          String    @id @default(cuid())
  workspaceId String
  tokens      Int
  model       String
  agentRole   String
  agentId     String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent       Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
}

model Job {
  id          String     @id @default(cuid())
  workspaceId String
  agentId     String?
  agentRole   String
  title       String
  prompt      String
  status      String     @default("queued")
  plan        String     @default("[]")
  context     String     @default("{}")
  playbookKey String?
  skillId     String?
  askPrompt   String     @default("")
  /// "clarify" (Yes/No or short answer) or "approve" (artifact approval).
  askKind     String     @default("")
  /// Persisted human reply when askKind is clarify. Empty until answered.
  userAnswer  String     @default("")
  runnerLock  String     @default("")
  error       String     @default("")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent       Agent?     @relation(fields: [agentId], references: [id], onDelete: SetNull)
  skill       Skill?     @relation(fields: [skillId], references: [id], onDelete: SetNull)
  events      JobEvent[]
  artifacts   Artifact[]

  @@index([workspaceId, status])
  @@index([workspaceId, agentId])
}

model JobEvent {
  id        String   @id @default(cuid())
  jobId     String
  type      String
  message   String
  stepId    String?
  data      String   @default("{}")
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model Skill {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  agentId     String?
  agentRole   String
  playbook    String
  sourceJobId String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent       Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  jobs        Job[]
}

/// Workspace-scoped developer keys. Store `keyHash` only — the secret is shown once at create.
model ApiKey {
  id              String    @id @default(cuid())
  workspaceId     String
  name            String    @default("Default")
  prefix          String    @unique
  keyHash         String    @unique
  lastUsedAt      DateTime?
  revokedAt       DateTime?
  rateWindowStart DateTime  @default(now())
  rateWindowCount Int       @default(0)
  createdAt       DateTime  @default(now())
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, revokedAt])
}

/// Dedupes inbound provider webhooks (Whop webhook-id / payment id).
model ProcessedWebhook {
  id         String   @id
  eventType  String
  externalId String?
  createdAt  DateTime @default(now())

  @@index([externalId])
}
