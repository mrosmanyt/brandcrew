generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  name         String
  createdAt    DateTime          @default(now())
  memberships  WorkspaceMember[]
}

model Workspace {
  id            String            @id @default(cuid())
  name          String
  slug          String            @unique
  plan          String            @default("demo")
  tokenUsed     Int               @default(0)
  tokenBudget   Int               @default(50000)
  brandKit      String            @default("{}")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  members       WorkspaceMember[]
  conversations Conversation[]
  artifacts     Artifact[]
  tasks         Task[]
  calendarItems CalendarItem[]
  usageEvents   UsageEvent[]
  jobs          Job[]
  skills        Skill[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  role        String    @default("owner")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
}

model Conversation {
  id          String     @id @default(cuid())
  workspaceId String
  agentRole   String
  createdAt   DateTime   @default(now())
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages    Message[]
  artifacts   Artifact[]

  @@unique([workspaceId, agentRole])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

model Artifact {
  id             String        @id @default(cuid())
  workspaceId    String
  conversationId String?
  jobId          String?
  agentRole      String
  type           String
  title          String
  content        String
  status         String        @default("draft")
  model          String        @default("demo")
  provider       String        @default("demo")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  job            Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  tasks          Task[]
}

model Task {
  id          String    @id @default(cuid())
  workspaceId String
  artifactId  String?
  title       String
  description String    @default("")
  status      String    @default("approve")
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  artifact    Artifact? @relation(fields: [artifactId], references: [id], onDelete: SetNull)
}

model CalendarItem {
  id          String    @id @default(cuid())
  workspaceId String
  date        String
  title       String
  channel     String
  content     String    @default("")
  artifactId  String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model UsageEvent {
  id          String    @id @default(cuid())
  workspaceId String
  tokens      Int
  model       String
  agentRole   String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Job {
  id          String     @id @default(cuid())
  workspaceId String
  agentRole   String
  title       String
  prompt      String
  status      String     @default("queued")
  plan        String     @default("[]")
  context     String     @default("{}")
  playbookKey String?
  skillId     String?
  askPrompt   String     @default("")
  runnerLock  String     @default("")
  error       String     @default("")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  skill       Skill?     @relation(fields: [skillId], references: [id], onDelete: SetNull)
  events      JobEvent[]
  artifacts   Artifact[]

  @@index([workspaceId, status])
}

model JobEvent {
  id        String   @id @default(cuid())
  jobId     String
  type      String
  message   String
  stepId    String?
  data      String   @default("{}")
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model Skill {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  agentRole   String
  playbook    String
  sourceJobId String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobs        Job[]
}
